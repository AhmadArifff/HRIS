{
  "name": "hris-monorepo",
  "version": "1.0.0",
  "author": "ahmad arif",
  "license": "HRISCorp.dev Enterprise License",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "concurrently \"npm run dev -w apps/admin-dashboard\" \"npm run dev -w apps/employee-portal\" \"npm run dev -w apps/backend-api\"",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "prettier": "^3.2.5",
    "turbo": "^2.1.2"
  },
  "overrides": {
    "@react-jvectormap/core": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    },
    "@react-jvectormap/world": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    }
  },
  "packageManager": "npm@10.5.0"
}
